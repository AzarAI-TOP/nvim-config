#!/bin/sh
# Pre-commit 钩子：用 StyLua 格式化暂存的 Lua 文件（fail-closed）。
# 通过 `git config core.hooksPath .githooks` 自行配置。
#
# 以下情况提交会被中止：
#   - 到处都找不到 StyLua（PATH、Mason packages、Mason bin），或
#   - 格式化失败，或
#   - 格式化后的 `stylua --check` 失败。
# 没有静默跳过路径：无法格式化的提交就是失败的提交。

set -e

# 只处理 Lua 文件
staged=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.lua$' || true)
if [ -z "$staged" ]; then
    exit 0
fi

# 查找 StyLua：先 PATH，再 Mason 包目录下的真实可执行文件
# （优先于 .CMD shim），最后 Mason 的 bin 目录。
stylua_cmd=$(command -v stylua 2>/dev/null || true)
if [ -z "$stylua_cmd" ]; then
    mason_dirs=
    [ -n "${LOCALAPPDATA:-}" ] && mason_dirs="$mason_dirs $LOCALAPPDATA/nvim-data/mason"
    [ -n "${XDG_DATA_HOME:-}" ] && mason_dirs="$mason_dirs $XDG_DATA_HOME/nvim/mason"
    mason_dirs="$mason_dirs ${HOME:-$HOME}/.local/share/nvim/mason"
    for dir in $mason_dirs; do
        for exe in "$dir"/packages/stylua/stylua.exe "$dir"/packages/stylua/*/stylua.exe \
            "$dir"/packages/stylua/stylua "$dir"/packages/stylua/*/stylua; do
            if [ -x "$exe" ] || [ -f "$exe" ]; then
                stylua_cmd=$exe
                break 2
            fi
        done
    done
fi
if [ -z "$stylua_cmd" ] && [ -n "${LOCALAPPDATA:-}" ]; then
    candidate="${LOCALAPPDATA}/nvim-data/mason/bin/stylua.CMD"
    [ -f "$candidate" ] && stylua_cmd=$candidate
fi
if [ -z "$stylua_cmd" ]; then
    candidate="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/mason/bin/stylua"
    [ -x "$candidate" ] && stylua_cmd=$candidate
fi
if [ -z "$stylua_cmd" ]; then
    echo "❌ 找不到 stylua——提交已中止。"
    echo "   安装方式：在 Neovim 中运行 :MasonToolsInstallSync，"
    echo "   或把 stylua 加入 PATH（例如 cargo install stylua）。"
    exit 1
fi

# 拒绝部分暂存的 Lua 文件。否则格式化工作区副本再重新 add，
# 会把无关的未暂存修改一并吸进提交。
for file in $staged; do
    if ! git diff --quiet -- "$file"; then
        echo "❌ $file 同时有暂存与未暂存的修改。提交前请先 stage 或 stash 它。"
        exit 1
    fi
done

# 原地格式化暂存的 Lua 文件，再验证结果确实通过干净的 --check
# （不允许静默的部分失败）。
echo "$staged" | tr '\n' '\0' | xargs -0 "$stylua_cmd"
if ! echo "$staged" | tr '\n' '\0' | xargs -0 "$stylua_cmd" --check; then
    echo "❌ 格式化后 stylua --check 失败——提交已中止。"
    exit 1
fi

# 重新暂存发生变化的文件
echo "$staged" | tr '\n' '\0' | xargs -0 git add
