#!/bin/bash
# Pre-commit hook: formats staged Lua files with StyLua (fail-closed).
# Enable it with `git config core.hooksPath .githooks`.
#
# The commit is aborted when:
#   - StyLua cannot be found anywhere (PATH, Mason packages, Mason bin), or
#   - formatting fails, or
#   - the formatted `stylua --check` fails.
# There is no silent skip path: an unformattable commit is a failed commit.

set -e

# Only handle Lua files
staged=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.lua$' || true)
if [ -z "$staged" ]; then
    exit 0
fi

# Find StyLua: PATH first, then the real executable inside the Mason packages
# dir (preferred over the .CMD shim), and finally Mason's bin dir.
stylua_cmd=$(command -v stylua 2>/dev/null || true)
if [ -z "$stylua_cmd" ]; then
    mason_dirs="$LOCALAPPDATA/nvim-data/mason"
    for exe in "$mason_dirs"/packages/stylua/stylua.exe "$mason_dirs"/packages/stylua/*/stylua.exe; do
        if [ -x "$exe" ] || [ -f "$exe" ]; then
            stylua_cmd=$exe
            break
        fi
    done
fi
if [ -z "$stylua_cmd" ] && [ -n "${LOCALAPPDATA:-}" ]; then
    candidate="${LOCALAPPDATA}/nvim-data/mason/bin/stylua.CMD"
    [ -f "$candidate" ] && stylua_cmd=$candidate
fi
if [ -z "$stylua_cmd" ]; then
    echo "❌ stylua not found — commit aborted."
    echo "    Install it with :MasonToolsInstallSync in Neovim,"
    echo "    or add stylua to PATH (e.g. cargo install stylua)."
    exit 1
fi

# Reject partially staged Lua files. Otherwise formatting the worktree copy
# and re-adding would sweep unrelated unstaged changes into the commit.
# NUL-separated so filenames with spaces survive the loop.
while IFS= read -r -d '' file; do
    if ! git diff --quiet -- "$file"; then
        echo "❌ $file has both staged and unstaged changes. Stage or stash it before committing."
        exit 1
    fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR | grep -z '\.lua$' || true)

# Format the staged Lua files in place, then verify the result passes a clean
# --check (no silent partial failures allowed).
echo "$staged" | tr '\n' '\0' | xargs -0 "$stylua_cmd"
if ! echo "$staged" | tr '\n' '\0' | xargs -0 "$stylua_cmd" --check; then
    echo "❌ stylua --check failed after formatting — commit aborted."
    exit 1
fi

# Re-stage the files that changed
echo "$staged" | tr '\n' '\0' | xargs -0 git add
