{
  "main": {
    "prefix": "main",
    "body": [
      "int main(int argc, char* argv[]) {",
      "    ${0:// body}",
      "    return 0;",
      "}"
    ],
    "description": "Main function"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:n}; ++${1:i}) {",
      "    ${0:// body}",
      "}"
    ],
    "description": "For loop"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    ${0:// body}",
      "}"
    ],
    "description": "While loop"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    ${0:// body}",
      "}"
    ],
    "description": "If statement"
  },
  "else": {
    "prefix": "else",
    "body": [
      "else {",
      "    ${0:// body}",
      "}"
    ],
    "description": "Else block"
  },
  "elif": {
    "prefix": "elif",
    "body": [
      "else if (${1:condition}) {",
      "    ${0:// body}",
      "}"
    ],
    "description": "Else-if statement"
  },
  "switch": {
    "prefix": "switch",
    "body": [
      "switch (${1:expr}) {",
      "    case ${2:value}:",
      "        ${0:// body}",
      "        break;",
      "    default:",
      "        break;",
      "}"
    ],
    "description": "Switch statement"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${0:// members}",
      "};"
    ],
    "description": "Struct definition"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      " public:",
      "    ${0:// public members}",
      " private:",
      "};"
    ],
    "description": "Class definition (Google Style)"
  },
  "include": {
    "prefix": "include",
    "body": "#include <${1:header}>",
    "description": "Include directive"
  },
  "define": {
    "prefix": "define",
    "body": "#define ${1:NAME} ${0:value}",
    "description": "Macro definition"
  },
  "printf": {
    "prefix": "printf",
    "body": "printf(\"${1:format}\\n\"${0:, args});",
    "description": "Printf call"
  },
  "sizeof": {
    "prefix": "sizeof",
    "body": "sizeof(${1:type})",
    "description": "Sizeof expression"
  },
  "typedef": {
    "prefix": "typedef",
    "body": "typedef ${1:type} ${0:name};",
    "description": "Typedef"
  },
  "guard": {
    "prefix": "guard",
    "body": [
      "#ifndef ${1:HEADER_GUARD_H_}",
      "#define ${1:HEADER_GUARD_H_}",
      "",
      "${0:// body}",
      "",
      "#endif  // ${1:HEADER_GUARD_H_}"
    ],
    "description": "Header guard"
  }
}